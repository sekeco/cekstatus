# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# ─── Better Auth ─────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=

# ─── URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Next.js client-side (wajib prefix NEXT_PUBLIC_)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ─── Upload ──────────────────────────────────────────────
# Default: backend/storage/uploads (relatif ke folder backend/)
UPLOAD_DIR=./storage/uploads

# ─── OAuth (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email (optional) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
